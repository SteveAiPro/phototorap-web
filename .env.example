# 环境变量模板 —— 复制为 .env.local 并填入真实值
#
# ⚠️ 任何真实凭据都不要写进源码或提交进 git。
# 2026-10-07 的事故就是 R2 密钥被硬编码进 src/lib/r2.ts 并推到公开仓库，
# 导致全量用户照片与视频可被任意人读写。
#
# 生产环境请在 Vercel → Project → Settings → Environment Variables 配置，
# 而不是提交 .env.production 文件。

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端专用，绝不能加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Replicate（视频生成）----------
REPLICATE_API_TOKEN=

# ---------- Cloudflare R2（图片与视频永久存储）----------
# 缺任一项时 uploadToR2 会抛错并降级到 Supabase Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=phototorap
# 桶的公开访问域名，结尾不要带斜杠
R2_PUBLIC_URL=

# ---------- 支付 ----------
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=

# ---------- 分析 ----------
NEXT_PUBLIC_GA_ID=
